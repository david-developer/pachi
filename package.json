{
  "name": "pachi",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "test:startup": "node --test scripts/*.test.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:startup && turbo run test",
    "db:migrate": "pnpm --filter @pachi/database db:migrate",
    "check:secrets": "bash scripts/check-secrets.sh",
    "check:dependencies": "node scripts/check-dependency-audit-policy.mjs && pnpm audit --audit-level low",
    "check:contracts": "node scripts/check-contracts.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.44.0",
    "@typescript-eslint/parser": "8.44.0",
    "eslint": "9.36.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "turbo": "2.11.3",
    "typescript": "5.9.2",
    "yaml": "2.9.1"
  }
}
