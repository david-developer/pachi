{
  "name": "pachi",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.0.0",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "test:startup": "node --test scripts/*.test.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:startup && turbo run test",
    "db:migrate": "pnpm --filter @pachi/database db:migrate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.44.0",
    "@typescript-eslint/parser": "8.44.0",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "turbo": "2.11.3",
    "typescript": "5.9.2"
  }
}
