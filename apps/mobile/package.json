{
  "name": "@pachi/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --clear --platform all",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "preview:test": "node scripts/preview-fixtures.mjs",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "dependencies": {
    "expo": "55.0.0",
    "expo-router": "6.0.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-web": "0.21.2",
    "@pachi/contracts": "workspace:*",
    "expo-font": "55.0.8",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@pachi/eslint-config": "workspace:*",
    "@pachi/typescript-config": "workspace:*",
    "@types/react": "19.2.2",
    "typescript": "5.9.2",
    "tsx": "4.20.5",
    "@types/node": "24.5.2"
  }
}
