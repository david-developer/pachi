{
  "name": "@pachi/database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:test": "node scripts/migrate-test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 src/**/*.test.ts",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": { "drizzle-orm": "0.44.5", "postgres": "3.4.7", "zod": "4.1.5" },
  "devDependencies": { "@pachi/eslint-config": "workspace:*", "@pachi/typescript-config": "workspace:*", "@types/node": "24.5.2", "drizzle-kit": "0.31.4", "tsx": "4.20.5", "typescript": "5.9.2" }
}
