NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://pachi:pachi_local_only@localhost:5432/pachi_local
LOG_LEVEL=info
MESSAGE_CONVERSATION_LIMIT=20
MESSAGE_GLOBAL_LIMIT=60
MESSAGE_WINDOW_SECONDS=60
COGNITO_ISSUER=
COGNITO_JWKS_URI=
COGNITO_CLIENT_IDS=
AUTH_REQUIRED_SCOPES=pachi/account
AUTH_ALLOW_TEST_ISSUER=false
PHONE_OTP_HMAC_SECRET=local-only-phone-otp-secret
SMS_PROVIDER=local
MEDIA_STORAGE_ROOT=../../.local-media
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
PACHI_API_URL=http://localhost:3001
WEB_SESSION_SECRET=local-development-session-secret-change-me-please-32
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback
COGNITO_LOGOUT_URI=http://localhost:3000

# Server-authored analytics snapshots; local/staging/CI traffic is always TEST.
ANALYTICS_ENVIRONMENT=development
# Set an explicit >=32-character secret to enable local analytics consumption.
ANALYTICS_PSEUDONYM_SECRET=
